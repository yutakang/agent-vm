#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

usage() {
  cat >&2 <<'EOF'
Usage:
  kvm-agent-authorize-controller-key [--allow-port-forwarding] PUBLIC_KEY

Run this inside the VM as the normal graphical user. PUBLIC_KEY is the complete
single line printed by macos/setup-secure-access.sh. It is not a secret.

The safe default permits shell and file-transfer access but disables SSH-agent,
port, X11, and user-rc forwarding for this key. --allow-port-forwarding is an
explicit opt-in for a remote editor and also requires the server-side
--allow-remote-editor setting.
EOF
  exit 2
}

allow_port_forwarding="no"
if [[ "${1:-}" == "--allow-port-forwarding" ]]; then
  allow_port_forwarding="yes"
  shift
fi
[[ $# -eq 1 ]] || usage

key_line="$1"
[[ "$key_line" != *$'\n'* && "$key_line" != *$'\r'* ]] || {
  echo 'The public key must be one complete line.' >&2
  exit 2
}

read -r key_type key_data key_comment <<< "$key_line"
[[ "$key_type" == ssh-ed25519 \
    && "$key_data" =~ ^[A-Za-z0-9+/]+={0,3}$ ]] || {
  echo 'Provide one valid ssh-ed25519 public key.' >&2
  exit 2
}

validation_file="$(mktemp)"
replacement_file=""
trap 'rm -f -- "$validation_file" "${replacement_file:-}"' EXIT
printf '%s\n' "$key_line" > "$validation_file"
ssh-keygen -l -f "$validation_file" >/dev/null || {
  echo 'ssh-keygen rejected the supplied public key.' >&2
  exit 2
}

ssh_directory="${HOME}/.ssh"
authorized_keys="${ssh_directory}/authorized_keys"
[[ ! -L "$ssh_directory" && ! -L "$authorized_keys" ]] || {
  echo 'Refusing to update a symbolic-link SSH path.' >&2
  exit 1
}
install -d -m 0700 "$ssh_directory"
touch "$authorized_keys"
chmod 0600 "$authorized_keys"

replacement_file="$(mktemp "${ssh_directory}/authorized_keys.XXXXXXXX")"
awk -v needle="${key_type} ${key_data}" \
  'index($0, needle) == 0 { print }' "$authorized_keys" > "$replacement_file"

key_options='no-agent-forwarding,no-port-forwarding,no-X11-forwarding,no-user-rc'
if [[ "$allow_port_forwarding" == "yes" ]]; then
  key_options='no-agent-forwarding,no-X11-forwarding,no-user-rc'
  printf 'Warning: client-initiated SSH port forwarding is enabled for this key.\n' >&2
fi
printf '%s %s\n' "$key_options" "$key_line" >> "$replacement_file"
chmod 0600 "$replacement_file"
mv -f -- "$replacement_file" "$authorized_keys"
replacement_file=""

printf 'Authorized controller key: '
ssh-keygen -lf "$validation_file" -E sha256 | awk '{print $2}'
printf 'Private keys remain on the trusted controller; only this public key was stored.\n'
